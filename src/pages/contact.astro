---
import Layout from '../layouts/Layout.astro';
---

<Layout title="お問い合わせ" pageId="contact">
  <main class="ly-main" id="main">
    <div class="ly-content-wrapper">
      <!-- / bg -->
      <div class="ly-content-bg is-contact"></div>
      <div class="main-content-inner">
        <!-- / Contact -->
        <section class="ly-section">
          <div class="section-heading">
            <h2 class="heading-text">Contact</h2>
          </div>
          <div class="section-contents">
            <div class="section-title">
              ご予約・お問い合わせ<br />
              お待ちしております
            </div>
            <div class="mod-contact-table">
              <div class="contact-item">
                <div class="item-headline">お電話</div>
                <div class="item-text">
                  <p class="tel-text"><a href="tel:0482878640">048-287-8640</a></p>
                </div>
              </div>
              <div class="contact-item">
                <div class="item-headline">HOT PEPPER</div>
                <div class="item-text">
                  <p class="contact-link-text">
                    <a href="https://beauty.hotpepper.jp/slnH000522231/" target="_blank" rel="noopener noreferrer">
                      &gt; HOT PEPPER の hair design nico+ ページへ
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>
